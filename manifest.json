{
  "name": "Wakapippi Vocal Remover Extension",
  "description": "AIが再生中のWeb動画からリアルタイムでボーカルを除去。ボーカルと伴奏のミックスも自由自在。すべてブラウザ内で処理されます。",
  "version": "1.0",
  "manifest_version": 3,
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content_script.js"
      ]
    }
  ],
  "permissions": [
    "offscreen",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval';"
  },
  "sandbox": {
    "pages": [
      "sandbox.html"
    ]
  },
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "service_worker.js"
  },
    "web_accessible_resources": [
    {
      "resources": [
        "vocal-remover-processor.js"
      ],
      "matches": ["<all_urls>"]
    }]
}